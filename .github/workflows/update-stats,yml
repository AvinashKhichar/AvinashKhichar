name: Update Profile Stats

on:
  schedule:
    - cron: "17 18 * * *" # Runs once daily (18:17 UTC = 23:47 IST)
  workflow_dispatch: # Allows manual runs from the Actions tab

concurrency:
  group: profile-stats-${{ github.repository }}
  cancel-in-progress: true

permissions:
  contents: write

jobs:
  build-stats:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Generate GitHub stats card
        uses: stats-organization/github-readme-stats-action@v2
        with:
          card: stats
          options: username=${{ github.repository_owner }}&theme=tokyonight&show_icons=true
          path: profile/stats.svg
          token: ${{ secrets.GH_STATS_TOKEN }}

      - name: Generate top languages card
        uses: stats-organization/github-readme-stats-action@v2
        with:
          card: top-langs
          options: username=${{ github.repository_owner }}&theme=tokyonight&layout=compact
          path: profile/top-langs.svg
          token: ${{ secrets.GH_STATS_TOKEN }}

      - name: Generate streak stats card
        uses: be-next/github-streak-stats-action@v1
        with:
          username: ${{ github.repository_owner }}
          theme: tokyonight
          timezone: Asia/Kolkata
          output: profile/streak.svg
          token: ${{ secrets.GH_STATS_TOKEN }}

      - name: Commit updated SVGs if changed
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add profile/
          git diff --cached --quiet || git commit -m "chore: update profile stats SVGs"
          git push
